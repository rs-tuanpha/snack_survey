{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "verbatimModuleSyntax": true,
    // Override deprecated options from @vue/tsconfig base
    "preserveValueImports": false,
    "importsNotUsedAsValues": "remove",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
