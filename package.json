    "@vitejs/plugin-vue-jsx": "^4",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.2",
    "@vue/tsconfig": "^0.1.3",
    "dotenv": "^16.1.4",
    "eslint": "^8.34.0",
    "eslint-plugin-vue": "^9.9.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.7.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0"
  }
