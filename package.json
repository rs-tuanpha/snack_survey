    "build-only": "vite build --base=/snack_survey/",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "sync-avatars": "bun scripts/index.ts"
  },
  "dependencies": {
    "@mdi/font": "^7.2.96",
    "@vuepic/vue-datepicker": "^5.2.1",
    "axios": "^1.3.6",
    "crypto-js": "^4.1.1",
    "dayjs": "^1.11.7",
    "firebase": "^9.22.2",
    "js-cookie": "^3.0.4",
    "lodash": "^4.17.21",
    "pinia": "^2.0.32",
    "vue": "^3.2.47",
    "vue-debounce": "^4.0.0",
    "vue-router": "^4.1.6",
    "vuefire": "^3.1.0"
  },
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.2.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/crypto-js": "^4.2.2",
    "@types/js-cookie": "^3.0.6",
